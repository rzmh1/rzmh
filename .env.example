# Copy or use npm run setup. Never commit .env or change an existing APP_KEY.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
HOST=0.0.0.0
PORT=3000
DATA_DIR=./runtime
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_KEY=
STORAGE_DRIVER=local
TRUST_PROXY=0
MAX_UPLOAD_BYTES=2147483648
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional private S3/R2 bucket. Keep values in the hosting secret manager.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional integrations; may also be configured in the owner dashboard.
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
